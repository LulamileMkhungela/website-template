{
  "name": "lulafind",
  "version": "1.0.0",
  "description": "LulaFind - community search network for missing people, KhumbulEkhaya and stories. Ionic + Angular + Capacitor.",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0.0 --port 4200",
    "build": "ng build --configuration production",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "preview": "node server.mjs",
    "test": "ng test --watch=false",
    "lint": "eslint \"src/**/*.ts\"",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios",
    "android:build": "cd android && ./gradlew assembleDebug",
    "setup:native": "node scripts/native-setup.mjs all"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/camera": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@ionic/angular": "^9.0.0",
    "@ionic/pwa-elements": "^3.4.0",
    "@supabase/supabase-js": "^2.109.0",
    "firebase": "^12.0.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/cli": "^8.0.0",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}